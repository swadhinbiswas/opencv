# ---- Environment (see .env.example) ----
NEXT_PUBLIC_APP_NAME="OpenCV"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Signed session cookie secret (REQUIRED for auth). Generate with:
# openssl rand -base64 32
AUTH_SECRET="dev-insecure-secret-change-me"

# Database. Uses a local libSQL file by default. Set to a Turso URL
# (libsql://...?authToken=...) when deploying.
DATABASE_URL="file:./dev.db"

# ---- Firebase. Real credentials switch the app from dev-auth to Google auth.
# Grab the browser config from Firebase console → Project settings → Your apps,
# and the service account key from Project settings → Service accounts.
# FIREBASE_PRIVATE_KEY is the single-line PEM with literal \n escapes (as it
# appears in the service account JSON). Leave blank for dev-auth fallback. ----
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PROJECT_ID=""
FIREBASE_DATABASE_URL=""

# ---- Upstash (optional). Without these an in-memory cache is used. ----
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Explicitly opt into "real" auth/deployment readiness when set to "1".
# When unset/blank, the app uses its local dev fallbacks automatically.